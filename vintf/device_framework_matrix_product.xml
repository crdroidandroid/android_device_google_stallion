<compatibility-matrix version="9.0" type="framework">
    <hal format="aidl">
        <name>vendor.google.ambience_hub</name>
        <interface>
            <name>IAmbienceHubConsumerManager</name>
            <instance>default</instance>
        </interface>
        <interface>
            <name>IAmbienceHubProducerManager</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl">
        <name>vendor.google.radio_ext</name>
        <version>3</version>
        <interface>
            <name>IRadioExt</name>
            <instance>default</instance>
        </interface>
    </hal>
</compatibility-matrix>
